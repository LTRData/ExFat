<Project>

  <PropertyGroup>

    <OutputPath Condition="'$(MSBuildProjectExtension)' != '.shfbproj'">..\bin\$(Configuration)\</OutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <LangVersion>Latest</LangVersion>
    <DebugType>portable</DebugType>
    <Deterministic>false</Deterministic>
    <TargetFrameworks>net40;net45;net48;netstandard2.0;netstandard2.1</TargetFrameworks>

    <DiscUtilsPath>$(SolutionDir)..\..\DiscUtils\Library\DiscUtils\bin\$(Configuration)\$(TargetFramework)</DiscUtilsPath>

  </PropertyGroup>

  <PropertyGroup>

    <Company>picrap</Company>
    <Product>ExFat</Product>
    <Copyright>MIT license https://opensource.org/licenses/MIT</Copyright>
    <Trademark></Trademark>
    <Culture></Culture>

    <Version>0.9.16</Version>
    <FileVersion>0.9.16</FileVersion>

  </PropertyGroup>
  
</Project>
